<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Main Screen</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
        background-color: #151515;
        background-size: cover;
      }

      .container {
        display: flex;
        width: 100%;
        height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .buttons {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        /* margin-top: 130px; */
      }

      .button-wrapper {
        width: 520px;
        height: auto;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .nav-button {
        width: 100%;
        height: 100%;
        border: none;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        border-radius: 10px;
        color: white;
        font-size: 20px;
        font-weight: bold;
        text-align: center;
        cursor: pointer;
        position: relative;
        z-index: 10;
      }

      .nav-button:focus {
        outline: none;
      }

      .ticket-button {
        border: 0;
        background-color: transparent;
        display: flex;
        /* align-items: center; */
        /* justify-content: center; */
        gap: 0;
      }
      .ticket-button img {
        height: 200px;
      }
      
      /* Only second image moves */
      .ticket-button.active .img-right {
        transform: rotate(12deg); /* adjust as needed */
      }
      .img-text{
        position: absolute;
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: 100%;
        width: 100%;
        top: 0px;
        left: 0px;
        font-size: 24px;
        font-weight: bold;
        color: #fff;
        padding: 24px 32px;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
      }
      .img-right{
        height: fit-content;
        width: fit-content;
        transition: all 0.2s ease-in-out;
        position: relative;
        display: flex;
        transform-origin: bottom left;
      }
      .ticket-content{
        display: flex;
        flex-direction: column;
        align-items: start;
        text-align: start;
        gap: 16px;
        width: 80%;
        margin-top: 20px;
      }
      .home-button{
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="buttons">
        <% let buttons = [ 
            { id: 'btn1', label: 'A1', head: "Myth, Epic & Moral Imagination", desc: "“From Sacred Text to Silver Screen: Stories that Forged Heroes, Ethics, and Collective Memory”", image: '/images/tickets/s1.png', activeImage: '/images/tickets/1.png' }, 
            { id: 'btn2', label: 'B1', head: "Cinema as Social Mirror", desc: "“From Sacred Text to Silver Screen: Stories that Forged Heroes, Ethics, and Collective Memory”", image: '/images/tickets/s2.png', activeImage: '/images/tickets/2.png' }, 
            { id: 'btn3', label: 'C1', head: "Language, Identity & Self -Assertion", desc: "“Words That Forged Belonging”", image: '/images/tickets/s3.png', activeImage: '/images/tickets/3.png' }, 
            { id: 'btn4', label: 'D1', head: "Reform, Revolution & the Written Word", desc: "“From Sacred Text to Silver Screen: Stories that Forged Heroes, Ethics, and Collective Memory”", image: '/images/tickets/s4.png', activeImage: '/images/tickets/4.png' }, 
            { id: 'btn5', label: 'E1', head: "Ritual, Performance & Living Traditions", desc: "“Traditions That Breathe, Move, and Return Each Season”", image: '/images/tickets/s5.png', activeImage: '/images/tickets/5.png' }, 
            { id: 'btn6', label: 'F1', head: " Everyday Culture & Material Life", desc: "“From Hearth to Field: The Texture of Everyday Living”", image: '/images/tickets/s6.png', activeImage: '/images/tickets/6.png' } 
        ]; %> <%
        buttons.forEach(button => { %>
        <div class="button-wrapper">
          <button
            class="ticket-button"
            id="<%= button.id %>"
            onclick="handleButtonClick('<%= button.id %>')"
          >
            <img src="<%= button.image %>" alt="<%= button.label %>" />
            <div class="img-right">
              <img src="<%= button.activeImage %>" alt="<%= button.label %>" />
              <div class="img-text">
                <img src="/images/avakaiLogo.png" alt="Logo" class="img-logo" style="height: 20px; width: fit-content;"/>
                <div class="ticket-content">
                  <div style="font-size: 24px;"><%= button.head %></div>
                  <div style="font-size: 10px;"><%= button.desc %></div>
                </div>
              </div>
            </div>
          </button>
        </div>
        <% }); %>
      </div>
      <div class="home-button">
        <img src="/images/home.png" alt="" onclick="handleButtonClick('btn7')"/>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();
      let buttonsDisabled = false;

      function disableAllButtons() {
        buttonsDisabled = true;
        document.querySelectorAll(".ticket-button").forEach((button) => {
          button.style.opacity = "0.5";
          button.style.pointerEvents = "none";
        });
        document.querySelectorAll(".home-button").forEach((button) => {
          button.style.opacity = "0.5";
          button.style.pointerEvents = "none";
        });
      }

      function enableAllButtons() {
        buttonsDisabled = false;
        document.querySelectorAll(".ticket-button").forEach((button) => {
          button.style.opacity = "1";
          button.style.pointerEvents = "auto";
        });
        document.querySelectorAll(".home-button").forEach((button) => {
          button.style.opacity = "1";
          button.style.pointerEvents = "auto";
        });
      }

      function handleButtonClick(id) {
        // clear active state from any previously clicked button
        if(id !== 'btn7'){
        
          document
            .querySelectorAll(".ticket-button")
            .forEach((btn) => btn.classList.remove("active"));

          if (buttonsDisabled) return;

          document.getElementById(id).classList.add("active");

        }
        const activeButton = document.getElementById(id);
        // Disable buttons while moving
        disableAllButtons();

        // Send button click to server
        // btn1-5 sends 1-5, btn6 sends 0 (home)
        socket.emit("buttonClick", { message: id });
      }

      // Re-enable buttons when reached destination (scroll complete)
      socket.on("scrollComplete", () => {
        console.log("Reached destination, enabling buttons");
        enableAllButtons();
      });

      // Re-enable buttons when video ends
      socket.on("videoEnded", () => {
        console.log("Video ended, enabling buttons");
        enableAllButtons();
      });

      // Also enable buttons when reached event comes
      socket.on("reached", () => {
        console.log("Reached event, enabling buttons");
        enableAllButtons();
      });
    </script>
  </body>
</html>
