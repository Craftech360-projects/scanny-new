<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Player with Background Image</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background: black;
        }

        #image-container {
            width: 100vw;
            height: 100vh;
            overflow-x: auto;
            /* Enable horizontal scrolling */
            overflow-y: hidden;
            white-space: nowrap;
            position: absolute;
            top: 0;
            left: 0;
            overflow-x: scroll !important;
            /* Force scrollbar */
            scroll-snap-type: x mandatory;
            /* Smooth scrolling */
        }

        .bg-image {
            width: 6480px;
            height: 100vh;
            object-fit: cover;
            display: inline-block;
        }

        video {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
            display: none;
        }

        /* Default Video (Hidden Initially) */
        #defaultVideo {
            position: absolute;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            display: none;
            /* Initially hidden */
        }

        /* Main Video Player */
        #videoPlayer {
            position: absolute;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            display: none;
            /* Initially hidden */
            z-index: 2;
            /* Above the background */
        }
    </style>
</head>

<body>

    <!-- Background Image -->
    <div id="image-container">
        <img class="bg-image" src="/images/bg3.jpg" alt="Background">
    </div>

    <!-- Default looping video (Hidden Initially) -->
    <video id="defaultVideo" loop autoplay muted>
        <source src="/videos/default.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <!-- Main Video Player -->
    <video id="videoPlayer" controls>
        <source id="videoSource" src="" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const videoPlayer = document.getElementById('videoPlayer');
        const videoSource = document.getElementById('videoSource');
        const defaultVideo = document.getElementById('defaultVideo');
        const imageContainer = document.getElementById('image-container');

        const socket = io();

        // Position mapping loaded from config.json via server
        // Maps OSC position values to pixel positions for image scrolling
        const POSITION_MAP = <%- JSON.stringify(positionMap) %>;

        // Button number to final pixel position mapping
        // Derived from POSITION_MAP - maps button numbers (0-5) to their target positions
        const BUTTON_TO_POSITION = (function() {
            const keys = Object.keys(POSITION_MAP).map(parseFloat).sort((a, b) => a - b);
            const map = {};
            keys.forEach((key, index) => {
                map[index] = POSITION_MAP[key];
            });
            return map;
        })();

        console.log('📍 POSITION_MAP:', POSITION_MAP);
        console.log('📍 BUTTON_TO_POSITION:', BUTTON_TO_POSITION);

        let currentTarget = 0;
        let startPosition = 0;

        function pauseAndHideAll() {
            console.log("⏸️ Pausing all videos");
            defaultVideo.pause();
            defaultVideo.style.display = 'none';
            videoPlayer.pause();
            videoPlayer.style.display = 'none';
        }

        function playNewVideo(videoFile) {
            pauseAndHideAll();
            videoSource.src = `/videos/${videoFile}`;
            videoPlayer.style.display = 'block';
            videoPlayer.load();
            videoPlayer.currentTime = 0;
            videoPlayer.play();
            console.log(`🎬 Playing: ${videoFile}`);
        }

        // Handle movement data from OSC via server
        // /movement { position: float }
        socket.on('movement', (data) => {
            const positionIndex = data.position;
            
            // Calculate pixel position using interpolation based on POSITION_MAP
            let newScrollLeft = 0;
            const keys = Object.keys(POSITION_MAP).map(parseFloat).sort((a, b) => a - b);
            
            if (positionIndex <= keys[0]) {
                newScrollLeft = POSITION_MAP[keys[0]];
            } else if (positionIndex >= keys[keys.length - 1]) {
                newScrollLeft = POSITION_MAP[keys[keys.length - 1]];
            } else {
                for (let i = 0; i < keys.length - 1; i++) {
                    const start = keys[i];
                    const end = keys[i+1];
                    if (positionIndex >= start && positionIndex <= end) {
                        const startPos = POSITION_MAP[start];
                        const endPos = POSITION_MAP[end];
                        const t = (positionIndex - start) / (end - start);
                        newScrollLeft = startPos + t * (endPos - startPos);
                        break;
                    }
                }
            }
            
            imageContainer.scrollLeft = newScrollLeft;
            console.log(`🔄 Moving to position index: ${positionIndex.toFixed(3)} (${newScrollLeft.toFixed(0)}px)`);
        });

        // Handle reached destination - play video
        socket.on('reached', (data) => {
            console.log(`📍 Reached position ${data.button}`);

            // Ensure we are physically at the target position using button mapping
            const targetPos = BUTTON_TO_POSITION[data.button];
            if (targetPos !== undefined) {
                imageContainer.scrollLeft = targetPos;
                currentTarget = data.button;
                startPosition = targetPos;
                console.log(`📍 Set final position to ${targetPos}px for button ${data.button}`);
            } else {
                console.warn(`⚠️ No position mapping for button ${data.button}`);
            }

            socket.emit('scrollComplete');
        });

        // Handle play video command from server
        socket.on('playVideo', (data) => {
            console.log(`🎬 Play video command: ${data.videoFile}`);
            playNewVideo(data.videoFile);
        });

        // Handle stop video command
        socket.on('stopVideo', () => {
            console.log('⏹️ Stop video command received');
            pauseAndHideAll();
        });

        // Handle hide everything
        socket.on('hideEverythinginVideoScreen', () => {
            console.log('🔴 Hiding all videos, showing background');
            pauseAndHideAll();
            document.getElementById('image-container').style.display = 'block';
        });

        // When video ends
        videoPlayer.addEventListener('ended', () => {
            console.log('🎬 Video ended');
            videoPlayer.pause();
            videoPlayer.style.display = 'none';
            videoPlayer.currentTime = 0;
            socket.emit('videoEnded');
        });
    </script>
</body>

</html>