<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Player with Background Image</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background: black;
        }

        #image-container {
            width: 100vw;
            height: 100vh;
            overflow-x: auto;
            /* Enable horizontal scrolling */
            overflow-y: hidden;
            white-space: nowrap;
            position: absolute;
            top: 0;
            left: 0;
            overflow-x: scroll !important;
            /* Force scrollbar */
            scroll-snap-type: x mandatory;
            /* Smooth scrolling */
        }

        .bg-image {
            width: 7560px;
            height: 100vh;
            object-fit: cover;
            display: inline-block;
        }

        video {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
            display: none;
        }

        /* Default Video (Hidden Initially) */
        #defaultVideo {
            position: absolute;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            display: none;
            /* Initially hidden */
        }

        /* Main Video Player */
        #videoPlayer {
            position: absolute;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            display: none;
            /* Initially hidden */
            z-index: 2;
            /* Above the background */
        }
    </style>
</head>

<body>

    <div id="image-container">
        <img class="bg-image" src="/images/bg3.jpg" alt="Background">
    </div>

    <video id="defaultVideo" loop autoplay muted>
        <source src="/videos/default.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <video id="videoPlayer" controls>
        <source id="videoSource" src="" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const videoPlayer = document.getElementById('videoPlayer');
        const videoSource = document.getElementById('videoSource');
        const defaultVideo = document.getElementById('defaultVideo');
        const imageContainer = document.getElementById('image-container');
        const socket = io();

        // 1. RAW CONFIG FROM SERVER
        // Passed from the Express server via EJS
        const RAW_POSITION_MAP = <%- JSON.stringify(positionMap) %>;

        // 2. ROBUST DATA CONVERSION
        // Convert the config object into a sorted array of objects { osc: 1.0, px: 3240 }
        // This prevents the "1" vs "1.0" lookup error causing NaN.
        const MAPPED_POSITIONS = Object.keys(RAW_POSITION_MAP)
            .map(key => ({
                osc: parseFloat(key),     // The position value (e.g., 1.0)
                px: RAW_POSITION_MAP[key] // The pixel value (e.g., 3240)
            }))
            .sort((a, b) => a.osc - b.osc); // Ensure strictly sorted order

        // 3. REGENERATE BUTTON MAPPING
        // Maps button index (0, 1, 2...) directly to pixel values using the sorted array indices
        const BUTTON_TO_POSITION = {};
        MAPPED_POSITIONS.forEach((item, index) => {
            BUTTON_TO_POSITION[index] = item.px;
        });

        console.log('📍 MAPPED_POSITIONS:', MAPPED_POSITIONS);
        console.log('📍 BUTTON_TO_POSITION:', BUTTON_TO_POSITION);

        let currentTarget = 0;
        let startPosition = 0;

        function pauseAndHideAll() {
            console.log("⏸️ Pausing all videos");
            defaultVideo.pause();
            defaultVideo.style.display = 'none';
            videoPlayer.pause();
            videoPlayer.style.display = 'none';
        }

        function playNewVideo(videoFile) {
            pauseAndHideAll();
            videoSource.src = `/videos/${videoFile}`;
            videoPlayer.style.display = 'block';
            videoPlayer.load();
            videoPlayer.currentTime = 0;
            videoPlayer.play();
            console.log(`🎬 Playing: ${videoFile}`);
        }

        // Handle movement data from OSC via server
        socket.on('movement', (data) => {
            const positionIndex = data.position;
            let newScrollLeft = 0;

            // Boundary checks: if outside range, clamp to start or end
            const firstPoint = MAPPED_POSITIONS[0];
            const lastPoint = MAPPED_POSITIONS[MAPPED_POSITIONS.length - 1];

            if (positionIndex <= firstPoint.osc) {
                newScrollLeft = firstPoint.px;
            } else if (positionIndex >= lastPoint.osc) {
                newScrollLeft = lastPoint.px;
            } else {
                // Interpolation Loop using our robust array
                // We find which two points we are between
                for (let i = 0; i < MAPPED_POSITIONS.length - 1; i++) {
                    const current = MAPPED_POSITIONS[i];
                    const next = MAPPED_POSITIONS[i + 1];

                    if (positionIndex >= current.osc && positionIndex <= next.osc) {
                        // Math: Linear Interpolation
                        const range = next.osc - current.osc;
                        const dist = positionIndex - current.osc;
                        const t = dist / range;
                        
                        // Calculate pixels
                        newScrollLeft = current.px + t * (next.px - current.px);
                        break; 
                    }
                }
            }
            
            imageContainer.scrollLeft = newScrollLeft;
            // console.log(`🔄 Moving: ${positionIndex.toFixed(3)} -> ${newScrollLeft.toFixed(0)}px`);
        });

        // Handle reached destination
        socket.on('reached', (data) => {
            console.log(`📍 Reached position ${data.button}`);
            const targetPos = BUTTON_TO_POSITION[data.button];
            
            if (targetPos !== undefined) {
                imageContainer.scrollLeft = targetPos;
                currentTarget = data.button;
                startPosition = targetPos;
                console.log(`📍 Set final position to ${targetPos}px`);
            } else {
                console.warn(`⚠️ No position mapping for button ${data.button}`);
            }
            socket.emit('scrollComplete');
        });

        socket.on('playVideo', (data) => {
            console.log(`🎬 Play video command: ${data.videoFile}`);
            playNewVideo(data.videoFile);
        });

        socket.on('stopVideo', () => {
            console.log('⏹️ Stop video command received');
            pauseAndHideAll();
        });

        socket.on('hideEverythinginVideoScreen', () => {
            console.log('🔴 Hiding all videos, showing background');
            pauseAndHideAll();
            document.getElementById('image-container').style.display = 'block';
        });

        videoPlayer.addEventListener('ended', () => {
            console.log('🎬 Video ended');
            videoPlayer.pause();
            videoPlayer.style.display = 'none';
            videoPlayer.currentTime = 0;
            socket.emit('videoEnded');
        });
    </script>
</body>

</html>
